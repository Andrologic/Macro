{
  "contract": "agsdl-0.2.0",
  "id": "macro-assistant",
  "bindings": {
    "engine": {
      "contract": {
        "identity": "macro/agent-engine",
        "version": "1"
      },
      "implementation": {
        "identity": "macro/desktop",
        "version": "1"
      }
    }
  },
  "configurations": {
    "standard": {
      "engine": "engine",
      "model": {
        "identity": "claude-sonnet-5-5",
        "version": "1"
      }
    }
  },
  "agents": {
    "agent1": {
      "configuration": "standard",
      "prompt": [
        {
          "value": "Répondre à la demande et présenter un résultat clair."
        }
      ],
      "interface": {
        "results": {
          "report": {
            "mediaTypes": [
              "text/plain"
            ],
            "required": true
          }
        }
      }
    }
  },
  "flow": {
    "entry": "agent1",
    "steps": {
      "agent1": {
        "type": "agent",
        "agent": "agent1",
        "next": []
      }
    }
  }
}
