{
  "contract": "agsdl-0.3.0",
  "id": "demo-crisis",
  "title": "Cellule de crise",
  "agents": {
    "metrics": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Chercher une cause dans les métriques. Produire report JSON avec approved, hypothesis et evidence. approved doit être étayé par des preuves."
    },
    "traces": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Chercher une cause dans les traces. Produire report JSON avec approved, hypothesis et evidence."
    },
    "customer": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Examiner les parcours affectés. Produire report JSON avec approved, hypothesis et evidence."
    },
    "lead": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Examiner la piste sous members et choisir intervenir, observer ou escalader selon le risque et les preuves."
    },
    "planner": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Préparer une intervention réversible. Produire report JSON avec approved, hypothesis et evidence."
    },
    "observer": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Évaluer la surveillance nécessaire. Produire report JSON avec approved, hypothesis et evidence."
    },
    "technical": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Vérifier la latence et les erreurs après la décision. Produire report JSON avec approved, hypothesis et evidence."
    },
    "business": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Vérifier les commandes et les parcours clients. Produire report JSON avec approved, hypothesis et evidence."
    },
    "reviewer": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Comparer toutes les preuves transmises. Produire report JSON avec approved, hypothesis et evidence."
    },
    "verifier": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Contre-expertiser le rapport transmis sans l’avoir rédigé. Vérifier que chaque preuve soutient l’hypothèse. Produire report JSON : approved vaut true seulement si les preuves suffisent ; reprendre l’hypothèse retenue et les preuves vérifiées."
    },
    "report": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Présenter les faits, les décisions, les effets observés et les points à suivre."
    },
    "escalation": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Expliquer le refus ou les preuves manquantes. Préparer les questions à trancher sans lancer d’intervention."
    },
    "recovery": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Identifier la frontière qui a échoué. Vérifier les effets réels avant toute nouvelle tentative."
    },
    "scene-assessment-handoff": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Transmettre le rapport"
    },
    "scene-assessment-check": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Preuves suffisantes ?"
    },
    "scene-main-launch": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Ouvrir les trois investigations"
    },
    "scene-main-first": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Première piste étayée"
    },
    "scene-main-operationsApproval": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Accord opérations"
    },
    "scene-main-securityApproval": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Accord sécurité"
    },
    "scene-main-deploy": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Intervenir sur le service"
    },
    "scene-main-watch": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Déclencher les contrôles"
    },
    "scene-main-all": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Attendre les deux contrôles"
    },
    "scene-main-evidence": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Rassembler les preuves"
    }
  },
  "flow": {
    "entry": "launch",
    "steps": {
      "launch": {
        "type": "agent",
        "agent": "scene-main-launch",
        "title": "Ouvrir les trois investigations",
        "next": "metrics"
      },
      "metrics": {
        "type": "agent",
        "agent": "metrics",
        "title": "Analyser les métriques",
        "next": "traces"
      },
      "traces": {
        "type": "agent",
        "agent": "traces",
        "title": "Analyser les traces",
        "next": "customer"
      },
      "customer": {
        "type": "agent",
        "agent": "customer",
        "title": "Analyser les parcours",
        "next": "first"
      },
      "first": {
        "type": "agent",
        "agent": "scene-main-first",
        "title": "Première piste étayée",
        "next": "decide"
      },
      "decide": {
        "type": "agent",
        "agent": "lead",
        "title": "Choisir la réponse",
        "next": "intervention"
      },
      "intervention": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "planner"
        },
        "title": "Préparer une intervention",
        "next": {
          "ready": [
            "observation"
          ],
          "revise": [
            "observation"
          ]
        }
      },
      "observation": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "observer"
        },
        "title": "Évaluer la surveillance",
        "next": {
          "ready": [
            "operationsApproval"
          ],
          "revise": [
            "operationsApproval"
          ]
        }
      },
      "operationsApproval": {
        "type": "agent",
        "agent": "scene-main-operationsApproval",
        "title": "Accord opérations",
        "next": "securityApproval"
      },
      "securityApproval": {
        "type": "agent",
        "agent": "scene-main-securityApproval",
        "title": "Accord sécurité",
        "next": "deploy"
      },
      "deploy": {
        "type": "agent",
        "agent": "scene-main-deploy",
        "title": "Intervenir sur le service",
        "next": "watch"
      },
      "watch": {
        "type": "agent",
        "agent": "scene-main-watch",
        "title": "Déclencher les contrôles",
        "next": "technical"
      },
      "technical": {
        "type": "agent",
        "agent": "technical",
        "title": "Vérifier les indicateurs",
        "next": "business"
      },
      "business": {
        "type": "agent",
        "agent": "business",
        "title": "Vérifier les commandes",
        "next": "all"
      },
      "all": {
        "type": "agent",
        "agent": "scene-main-all",
        "title": "Attendre les deux contrôles",
        "next": "evidence"
      },
      "evidence": {
        "type": "agent",
        "agent": "scene-main-evidence",
        "title": "Rassembler les preuves",
        "next": "closure"
      },
      "closure": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "reviewer"
        },
        "title": "Auditer la clôture",
        "next": {
          "ready": [
            "report"
          ],
          "revise": [
            "report"
          ]
        }
      },
      "report": {
        "type": "agent",
        "agent": "report",
        "title": "Rapport de clôture",
        "next": "escalation"
      },
      "escalation": {
        "type": "agent",
        "agent": "escalation",
        "title": "Coordination humaine",
        "next": "recovery"
      },
      "recovery": {
        "type": "agent",
        "agent": "recovery",
        "title": "Examiner l’échec technique"
      }
    }
  },
  "compositions": {
    "assessment": {
      "entry": "review",
      "steps": {
        "review": {
          "type": "agent",
          "agent": {
            "parameter": "specialist"
          },
          "title": "Mobiliser le spécialiste",
          "next": "handoff"
        },
        "handoff": {
          "type": "agent",
          "agent": "scene-assessment-handoff",
          "title": "Transmettre le rapport",
          "next": "counterCheck"
        },
        "counterCheck": {
          "type": "agent",
          "agent": "verifier",
          "title": "Contre-expertiser",
          "next": "check"
        },
        "check": {
          "type": "agent",
          "agent": "scene-assessment-check",
          "title": "Preuves suffisantes ?",
          "next": {
            "ready": {
              "output": "ready"
            },
            "revise": {
              "output": "revise"
            }
          }
        }
      },
      "parameters": [
        "specialist"
      ],
      "outputs": [
        "ready",
        "revise"
      ]
    }
  }
}
