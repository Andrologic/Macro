  "flow": {
    "entry": "launch",
    "steps": {
      "launch": {
        "type": "prepare",
        "message": {
          "prompt": [
            {
              "value": "Incident catalogue : identifier une piste étayée et préserver les commandes."
            }
          ],
          "resources": {
            "mode": {
              "ref": "mode"
            },
            "incident": {
              "ref": "incident"
            }
          }
        },
        "next": [
          "metrics",
          "traces",
          "customer"
        ]
      },
      "metrics": {
        "type": "agent",
        "agent": "metrics",
        "next": [
          "first"
        ]
      },
      "traces": {
        "type": "agent",
        "agent": "traces",
        "next": [
          "first"
        ]
      },
      "customer": {
        "type": "agent",
        "agent": "customer",
        "next": [
          "first"
        ]
      },
      "first": {
        "type": "join",
        "after": "launch",
        "members": [
          "metrics",
          "traces",
          "customer"
        ],
        "mode": "first",
        "accept": {
          "equals": [
            {
              "path": [
                "results",
                "report",
                "value",
                "approved"
              ]
            },
            {
              "value": true
            }
          ]
        },
        "remaining": "finish",
        "next": [
          "decide"
        ],
        "onError": [
          "recovery"
        ]
      },
      "decide": {
        "type": "agent",
        "agent": "lead",
        "decision": {
          "binding": "decision",
          "choices": [
            "intervenir",
            "observer",
            "escalader"
          ]
        },
        "next": {
          "intervenir": [
            "intervention"
          ],
          "observer": [
            "observation"
          ],
          "escalader": [
            "escalation"
          ]
        }
      },
      "intervention": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "planner"
        },
        "next": {
          "ready": [
            "operationsApproval"
          ],
          "revise": [
            "escalation"
          ]
        },
        "onError": [
          "recovery"
        ]
      },
      "observation": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "observer"
        },
        "next": {
          "ready": [
            "watch"
          ],
          "revise": [
            "escalation"
          ]
        },
        "onError": [
          "recovery"
        ]
      },
      "operationsApproval": {
        "type": "approval",
        "call": "deploy",
        "binding": "operationsApproval",
        "timeoutMs": 600000,
        "validForMs": 900000,
        "next": {
          "approved": [
            "securityApproval"
          ],
          "denied": [
            "escalation"
          ]
        },
        "onError": [
          "recovery"
        ]
      },
      "securityApproval": {
        "type": "approval",
        "call": "deploy",
        "binding": "securityApproval",
        "timeoutMs": 300000,
        "validForMs": 300000,
        "next": {
          "approved": [
            "deploy"
          ],
          "denied": [
            "escalation"
          ]
        },
        "onError": [
          "recovery"
        ]
      },
      "deploy": {
        "type": "call",
        "binding": "deployment",
        "arguments": {
          "assessment": {
            "path": [
              "results",
              "report",
              "value"
            ]
          }
        },
        "scope": {
          "action": "deploy",
          "resources": [
            "service:helio/catalog-api"
          ],
          "context": {
            "path": []
          }
        },
        "next": [
          "watch"
        ],
        "onError": [
          "recovery"
        ]
      },
      "watch": {
        "type": "prepare",
        "message": {
          "prompt": [
            {
              "value": "Contrôler les indicateurs techniques et les parcours métier."
            }
          ],
          "resources": {
            "observation": {
              "select": {
                "path": []
              },
              "mediaType": "application/json"
            }
          }
        },
        "next": [
          "technical",
          "business"
        ]
      },
      "technical": {
        "type": "agent",
        "agent": "technical",
        "next": [
          "all"
        ]
      },
      "business": {
        "type": "agent",
        "agent": "business",
        "next": [
          "all"
        ]
      },
      "all": {
        "type": "join",
        "after": "watch",
        "members": [
          "technical",
          "business"
        ],
        "mode": "all",
        "next": [
          "evidence"
        ],
        "onError": [
          "recovery"
        ]
      },
      "evidence": {
        "type": "prepare",
        "message": {
          "resources": {
            "technical": {
              "source": {
                "path": [
                  "members",
                  "technical",
                  "results",
                  "report"
                ]
              }
            },
            "business": {
              "source": {
                "path": [
                  "members",
                  "business",
                  "results",
                  "report"
                ]
              }
            }
          },
          "prompt": [
            {
              "value": "Auditer les deux contrôles joints et statuer sur la clôture."
            }
          ]
        },
        "next": [
          "closure"
        ]
      },
      "closure": {
        "type": "compose",
        "composition": "assessment",
        "agents": {
          "specialist": "reviewer"
        },
        "next": {
          "ready": [
            "report"
          ],
          "revise": [
            "escalation"
          ]
        },
        "onError": [
          "recovery"
        ]
      },
      "report": {
        "type": "agent",
        "agent": "report",
        "next": []
      },
      "escalation": {
        "type": "agent",
        "agent": "escalation",
        "next": []
      },
      "recovery": {
        "type": "agent",
        "agent": "recovery",
        "next": []
      }
    }
  },
  "compositions": {
    "assessment": {
      "agentParameters": [
        "specialist"
      ],
      "entry": "review",
      "outputs": [
        "ready",
        "revise"
      ],
      "steps": {
        "review": {
          "type": "agent",
          "agent": {
            "parameter": "specialist"
          },
          "next": [
            "handoff"
          ],
          "onError": [
            {
              "error": true
            }
          ],
          "maxVisits": 2
        },
        "handoff": {
          "type": "prepare",
          "message": {
            "prompt": [
              {
                "value": "Contre-expertiser ce rapport avant toute suite."
              }
            ],
            "resources": {
              "report": {
                "source": {
                  "path": [
                    "results",
                    "report"
                  ]
                }
              }
            }
          },
          "next": [
            "counterCheck"
          ]
        },
        "counterCheck": {
          "type": "agent",
          "agent": "verifier",
          "next": [
            "check"
          ],
          "onError": [
            {
              "error": true
            }
          ]
        },
        "check": {
          "type": "condition",
          "test": {
            "all": [
              {
                "equals": [
                  {
                    "path": [
                      "results",
                      "report",
                      "value",
                      "approved"
                    ]
                  },
                  {
                    "value": true
                  }
                ]
              },
              {
                "not": {
                  "equals": [
                    {
                      "path": [
                        "results",
                        "report",
                        "value",
                        "hypothesis"
                      ]
                    },
                    {
                      "value": ""
                    }
                  ]
                }
              }
            ]
          },
          "next": {
            "true": [
              {
                "output": "ready"
              }
            ],
            "false": [
              {
                "output": "revise"
              }
            ]
          },
          "onError": [
            {
              "error": true
            }
          ]
        }
      }
    }
  },
  "skills": {
    "diagnosis": {
      "prompt": [
        {
          "value": "Séparer les observations des hypothèses et joindre les mesures qui les étayent."
        }
      ]
    },
    "risk": {
      "prompt": [
        {
          "value": "Examiner la réversibilité et l’impact sur les commandes avant toute intervention."
        }
      ]
    },
    "reporting": {
      "prompt": [
        {
          "value": "Présenter les décisions et les preuves dans un compte rendu concis."
        }
      ]
    }
  }
}
