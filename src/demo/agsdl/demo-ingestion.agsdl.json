{
  "contract": "agsdl-0.2.0",
  "id": "demo-ingestion",
  "content": {
    "supplierFile": {
      "uri": "sftp://fournisseurs.helio.example/catalogue-2026-01.csv",
      "mediaType": "text/csv"
    }
  },
  "bindings": {
    "engine": {
      "contract": {
        "identity": "macro/agent-engine",
        "version": "1"
      },
      "implementation": {
        "identity": "macro/desktop",
        "version": "1"
      }
    },
    "catalogValidation": {
      "contract": {
        "identity": "macro/schema-validation",
        "version": "1"
      },
      "implementation": {
        "identity": "macro/desktop",
        "version": "1"
      },
      "effects": "none"
    },
    "catalogStorage": {
      "contract": {
        "identity": "macro/catalog-store",
        "version": "1"
      },
      "implementation": {
        "identity": "helio/catalog-api",
        "version": "1"
      },
      "effects": "external"
    },
    "warehouse": {
      "contract": {
        "identity": "macro/sql-warehouse",
        "version": "1"
      },
      "implementation": {
        "identity": "duckdb/local",
        "version": "1"
      },
      "effects": "none"
    }
  },
  "configurations": {
    "analyse": {
      "engine": "engine",
      "model": {
        "identity": "claude-sonnet-5-5",
        "version": "1"
      },
      "tools": {
        "warehouse": "warehouse"
      }
    },
    "redaction": {
      "engine": "engine",
      "model": {
        "identity": "claude-sonnet-5-5",
        "version": "1"
      }
    }
  },
  "agents": {
    "inspect": {
      "configuration": "analyse",
      "prompt": [
        {
          "value": "Détecter les colonnes, le séparateur et les champs obligatoires. Signaler les changements de format."
        }
      ],
      "interface": {
        "results": {
          "report": {
            "mediaTypes": [
              "text/plain"
            ],
            "required": true
          }
        }
      },
      "resources": {
        "file": {
          "ref": "supplierFile"
        }
      }
    },
    "normalize": {
      "configuration": "analyse",
      "prompt": [
        {
          "value": "Uniformiser les prix, les devises et les identifiants. Chaque ligne respecte le schéma du catalogue ; signaler à part les valeurs d’origine modifiées."
        }
      ],
      "interface": {
        "results": {
          "report": {
            "mediaTypes": [
              "application/json"
            ],
            "required": true,
            "valueSchema": {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sku": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "currency": {
                        "type": "string",
                        "enum": [
                          "EUR",
                          "USD"
                        ]
                      }
                    },
                    "required": [
                      "sku",
                      "price",
                      "currency"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "lines"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "repair": {
      "configuration": "analyse",
      "prompt": [
        {
          "value": "Expliquer les lignes rejetées et proposer une correction. Ne pas supprimer silencieusement les doublons."
        }
      ],
      "interface": {
        "results": {
          "report": {
            "mediaTypes": [
              "text/plain"
            ],
            "required": true
          }
        }
      }
    },
    "report": {
      "configuration": "redaction",
      "prompt": [
        {
          "value": "Présenter le nombre de lignes acceptées, rejetées et modifiées, avec des exemples."
        }
      ],
      "interface": {
        "results": {
          "report": {
            "mediaTypes": [
              "text/plain"
            ],
            "required": true
          }
        }
      }
    }
  },
  "flow": {
    "entry": "inspect",
    "steps": {
      "inspect": {
        "type": "agent",
        "agent": "inspect",
        "next": [
          "prepare"
        ]
      },
      "prepare": {
        "type": "prepare",
        "message": {
          "resources": {
            "report": {
              "source": {
                "path": [
                  "results",
                  "report"
                ]
              }
            }
          }
        },
        "next": [
          "normalize"
        ]
      },
      "normalize": {
        "type": "agent",
        "agent": "normalize",
        "next": [
          "validate"
        ],
        "maxVisits": 3,
        "onError": [
          "correctable"
        ]
      },
      "validate": {
        "type": "call",
        "binding": "catalogValidation",
        "next": [
          "valid"
        ],
        "onError": [
          "repair"
        ]
      },
      "valid": {
        "type": "condition",
        "test": {
          "equals": [
            {
              "path": [
                "text"
              ]
            },
            {
              "value": "Valide"
            }
          ]
        },
        "next": {
          "true": [
            "store"
          ],
          "false": [
            "repair"
          ]
        }
      },
      "repair": {
        "type": "agent",
        "agent": "repair",
        "next": [
          "handoff"
        ]
      },
      "store": {
        "type": "call",
        "binding": "catalogStorage",
        "next": [
          "handoff"
        ],
        "scope": {
          "action": "store",
          "resources": [
            "catalog:helio/fournisseurs"
          ],
          "context": {
            "value": "Import du catalogue de janvier 2026"
          }
        }
      },
      "handoff": {
        "type": "prepare",
        "message": {
          "resources": {
            "report": {
              "source": {
                "path": [
                  "results",
                  "report"
                ]
              }
            }
          }
        },
        "next": [
          "report"
        ]
      },
      "report": {
        "type": "agent",
        "agent": "report",
        "next": []
      },
      "correctable": {
        "type": "condition",
        "test": {
          "equals": [
            {
              "path": [
                "error",
                "code"
              ]
            },
            {
              "value": "OUTPUT_CONSTRAINT"
            }
          ]
        },
        "next": {
          "true": [
            "feedback"
          ],
          "false": [
            "repair"
          ]
        }
      },
      "feedback": {
        "type": "prepare",
        "message": {
          "prompt": [
            {
              "value": "Corriger le résultat selon les erreurs de validation jointes."
            }
          ],
          "resources": {
            "outputErrors": {
              "select": {
                "path": [
                  "error"
                ]
              },
              "mediaType": "application/json"
            }
          }
        },
        "next": [
          "normalize"
        ]
      }
    }
  }
}
