{
  "contract": "agsdl-0.3.0",
  "id": "demo-voice",
  "title": "Compte rendu vocal",
  "agents": {
    "transcribe": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Transcrire l’enregistrement. Marquer les passages incertains et identifier les interlocuteurs."
    },
    "clarify": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Demander à la personne qui a fourni l’audio de préciser les passages ambigus. Conserver les incertitudes non résolues."
    },
    "summarize": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Produire un résumé structuré : décisions, responsables et échéances. Ne pas inventer de décisions."
    },
    "review": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Comparer le compte rendu à la transcription et signaler les omissions."
    },
    "scene-main-confidence": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Passages incertains ?"
    },
    "scene-main-prepare": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Préparer la transcription"
    },
    "scene-main-handoff": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": "Transmettre le compte rendu"
    }
  },
  "flow": {
    "entry": "transcribe",
    "steps": {
      "transcribe": {
        "type": "agent",
        "agent": "transcribe",
        "title": "Transcrire la réunion",
        "next": "confidence"
      },
      "confidence": {
        "type": "agent",
        "agent": "scene-main-confidence",
        "title": "Passages incertains ?",
        "next": "clarify"
      },
      "clarify": {
        "type": "agent",
        "agent": "clarify",
        "title": "Clarifier les passages ambigus",
        "next": "prepare"
      },
      "prepare": {
        "type": "agent",
        "agent": "scene-main-prepare",
        "title": "Préparer la transcription",
        "next": "summarize"
      },
      "summarize": {
        "type": "agent",
        "agent": "summarize",
        "title": "Rédiger le compte rendu",
        "next": "handoff"
      },
      "handoff": {
        "type": "agent",
        "agent": "scene-main-handoff",
        "title": "Transmettre le compte rendu",
        "next": "review"
      },
      "review": {
        "type": "agent",
        "agent": "review",
        "title": "Vérifier la fidélité"
      }
    }
  }
}
