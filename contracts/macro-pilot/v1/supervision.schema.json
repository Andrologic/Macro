{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macro.andrologic.ai/macro-pilot/v1/supervision.schema.json",
  "title": "Macro Pilot supervision resources 1.0",
  "x-semantic-rules": [
    "task project_ids and context_project_ids MUST be disjoint and unique",
    "task execution_targets MUST identify each actionable project exactly once",
    "decision steps MUST use distinct identifiers and choices MUST be distinct within each step",
    "decision resolution MUST answer every step exactly once using a listed choice string or allowed free text",
    "tool approval resolution grant_scope MUST belong to allowed_scopes",
    "run.waiting_on MUST identify the same instance, workspace, task, and run as run.ref",
    "review.related_run MUST identify the same instance, workspace, task, and run as review.ref"
  ],
  "oneOf": [
    { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/toolApproval" },
    { "$ref": "#/$defs/review" }
  ],
  "$defs": {
    "taskExecutionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "execution_mode"],
      "properties": {
        "project_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "execution_mode": { "enum": ["git", "direct"] }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "type", "ref", "project_ids", "execution_targets", "title", "state", "revision", "updated_at"],
      "properties": {
        "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
        "type": { "const": "task" },
        "ref": { "$ref": "common.schema.json#/$defs/taskRef" },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "context_project_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "execution_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taskExecutionTarget" }
        },
        "title": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 300 },
        "state": { "enum": ["queued", "running", "waiting_decision", "waiting_tool_approval", "review_ready", "blocked", "completed", "failed", "cancelled"] },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "type", "ref", "state", "revision", "created_at", "updated_at"],
      "properties": {
        "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
        "type": { "const": "run" },
        "ref": { "$ref": "common.schema.json#/$defs/runRef" },
        "state": { "enum": ["pending", "running", "waiting_decision", "waiting_tool_approval", "completed", "failed", "cancelled", "interrupted"] },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "finished_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "waiting_on": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/decisionRef" },
            { "$ref": "common.schema.json#/$defs/toolApprovalRef" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "waiting_decision" } } },
          "then": {
            "properties": { "waiting_on": { "$ref": "common.schema.json#/$defs/decisionRef" } },
            "required": ["waiting_on"]
          }
        },
        {
          "if": { "properties": { "state": { "const": "waiting_tool_approval" } } },
          "then": {
            "properties": {
              "waiting_on": {
                "allOf": [
                  { "$ref": "common.schema.json#/$defs/toolApprovalRef" },
                  {
                    "type": "object",
                    "properties": {
                      "workspace_id": true,
                      "task_id": true,
                      "run_id": true
                    },
                    "required": ["workspace_id", "task_id", "run_id"]
                  }
                ]
              }
            },
            "required": ["waiting_on"]
          }
        },
        {
          "if": {
            "properties": {
              "state": { "not": { "enum": ["waiting_decision", "waiting_tool_approval"] } }
            }
          },
          "then": { "properties": { "waiting_on": false } }
        },
        {
          "if": { "properties": { "state": { "enum": ["running", "waiting_decision", "waiting_tool_approval", "completed"] } } },
          "then": {
            "properties": { "started_at": true },
            "required": ["started_at"]
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["completed", "failed", "cancelled", "interrupted"] } } },
          "then": {
            "properties": { "finished_at": true },
            "required": ["finished_at"]
          },
          "else": { "properties": { "finished_at": false } }
        }
      ]
    },
    "decisionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "prompt", "choices", "free_text_allowed"],
      "properties": {
        "step_id": { "$ref": "common.schema.json#/$defs/questionStepId" },
        "prompt": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 4000 },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "free_text_allowed": { "type": "boolean" },
        "free_text_placeholder": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "decisionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "answer"],
      "properties": {
        "step_id": { "$ref": "common.schema.json#/$defs/questionStepId" },
        "answer": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "decisionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answers", "resolved_by", "resolved_at"],
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decisionAnswer" }
        },
        "resolved_by": { "$ref": "common.schema.json#/$defs/actorRef" },
        "resolved_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "type", "ref", "state", "steps", "revision", "created_at"],
      "properties": {
        "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
        "type": { "const": "decision" },
        "ref": { "$ref": "common.schema.json#/$defs/decisionRef" },
        "state": { "enum": ["pending", "resolved", "expired", "cancelled"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decisionStep" }
        },
        "resolution": { "$ref": "#/$defs/decisionResolution" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "resolved" } } },
          "then": {
            "properties": { "resolution": true },
            "required": ["resolution"]
          },
          "else": { "properties": { "resolution": false } }
        },
        {
          "if": { "properties": { "state": { "const": "expired" } } },
          "then": {
            "properties": { "expires_at": true },
            "required": ["expires_at"]
          }
        }
      ]
    },
    "toolApprovalResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "resolved_by", "resolved_at"],
      "properties": {
        "verdict": { "enum": ["approve", "deny"] },
        "grant_scope": { "enum": ["once", "conversation"] },
        "reason": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 500 },
        "resolved_by": { "$ref": "common.schema.json#/$defs/actorRef" },
        "resolved_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "approve" } } },
          "then": {
            "properties": { "grant_scope": true, "reason": false },
            "required": ["grant_scope"]
          },
          "else": { "properties": { "grant_scope": false } }
        }
      ]
    },
    "toolApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "type", "ref", "state", "tool_id", "action_group", "risk_level", "is_destructive", "summary", "allowed_scopes", "revision", "created_at"],
      "properties": {
        "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
        "type": { "const": "tool_approval" },
        "ref": { "$ref": "common.schema.json#/$defs/toolApprovalRef" },
        "state": { "enum": ["pending", "resolved", "expired", "interrupted"] },
        "tool_id": { "$ref": "common.schema.json#/$defs/sourceId" },
        "action_group": { "enum": ["observe", "change", "escape"] },
        "risk_level": { "enum": ["strict", "balanced", "yolo"] },
        "is_destructive": { "type": "boolean" },
        "summary": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 1000 },
        "allowed_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": { "const": "once" },
          "items": { "enum": ["once", "conversation"] }
        },
        "resolution": { "$ref": "#/$defs/toolApprovalResolution" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "resolved" } } },
          "then": {
            "properties": { "resolution": true },
            "required": ["resolution"]
          },
          "else": { "properties": { "resolution": false } }
        },
        {
          "if": { "properties": { "state": { "const": "expired" } } },
          "then": {
            "properties": { "expires_at": true },
            "required": ["expires_at"]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "type", "ref", "related_run", "git_revision", "state", "revision", "updated_at"],
      "properties": {
        "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
        "type": { "const": "review" },
        "ref": { "$ref": "common.schema.json#/$defs/reviewRef" },
        "related_run": { "$ref": "common.schema.json#/$defs/runRef" },
        "git_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_sha", "head_sha"],
          "properties": {
            "base_sha": { "$ref": "common.schema.json#/$defs/gitSha" },
            "head_sha": { "$ref": "common.schema.json#/$defs/gitSha" }
          }
        },
        "state": { "enum": ["pending", "changes_requested", "approved", "superseded"] },
        "verdict_note": { "$ref": "common.schema.json#/$defs/safeText", "type": "string", "minLength": 1, "maxLength": 4000 },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
