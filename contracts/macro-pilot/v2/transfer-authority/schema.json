{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-authority/schema.json",
  "title": "Closed transfer-authority-1 companion, contract only",
  "$ref": "#/$defs/message",
  "$defs": {
    "date": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "controllerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_instance_id",
        "target_instance_id"
      ],
      "properties": {
        "kind": {
          "const": "controller"
        },
        "source_instance_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/id"
        },
        "target_instance_id": {
          "oneOf": [
            {
              "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "producerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instance_id"
      ],
      "properties": {
        "kind": {
          "const": "producer"
        },
        "instance_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/id"
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/controllerScope"
        },
        {
          "$ref": "#/$defs/producerScope"
        }
      ]
    },
    "activeProducer": {
      "allOf": [
        {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/producer"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "active"
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_contract",
        "type",
        "request_id",
        "scope"
      ],
      "properties": {
        "authority_contract": {
          "const": "transfer-authority-1"
        },
        "type": {
          "const": "preflight"
        },
        "request_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/uuid"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "controllerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_contract",
        "type",
        "request_id",
        "authority_origin",
        "issued_at",
        "expires_at",
        "scope",
        "actor",
        "source_producer",
        "target_producer",
        "recovery_generation",
        "history"
      ],
      "properties": {
        "authority_contract": {
          "const": "transfer-authority-1"
        },
        "type": {
          "const": "authority_snapshot"
        },
        "request_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/uuid"
        },
        "authority_origin": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/origin"
        },
        "issued_at": {
          "$ref": "#/$defs/date"
        },
        "expires_at": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "$ref": "#/$defs/controllerScope"
        },
        "actor": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/actor"
        },
        "source_producer": {
          "$ref": "#/$defs/activeProducer"
        },
        "target_producer": {
          "oneOf": [
            {
              "$ref": "#/$defs/activeProducer"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_generation": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/uuid"
        },
        "history": {
          "enum": [
            "intact",
            "restored"
          ]
        }
      }
    },
    "producerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_contract",
        "type",
        "request_id",
        "authority_origin",
        "issued_at",
        "expires_at",
        "scope",
        "producer"
      ],
      "properties": {
        "authority_contract": {
          "const": "transfer-authority-1"
        },
        "type": {
          "const": "authority_snapshot"
        },
        "request_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/uuid"
        },
        "authority_origin": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/origin"
        },
        "issued_at": {
          "$ref": "#/$defs/date"
        },
        "expires_at": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "$ref": "#/$defs/producerScope"
        },
        "producer": {
          "$ref": "#/$defs/activeProducer"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_contract",
        "type",
        "request_id",
        "code",
        "retryable"
      ],
      "properties": {
        "authority_contract": {
          "const": "transfer-authority-1"
        },
        "type": {
          "const": "authority_error"
        },
        "request_id": {
          "$ref": "https://schemas.macro.andrologic.ai/macro-pilot/v2/transfer-decision.schema.json#/$defs/uuid"
        },
        "code": {
          "enum": [
            "validation_failed",
            "unsupported_version",
            "unauthorized",
            "session_revoked",
            "forbidden",
            "authority_changed",
            "producer_changed",
            "instance_offline",
            "recovery_hold",
            "resource_limit",
            "unavailable"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "$ref": "#/$defs/controllerSnapshot"
        },
        {
          "$ref": "#/$defs/producerSnapshot"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "message": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "$ref": "#/$defs/response"
        }
      ]
    }
  }
}
