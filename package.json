  "type": "module",
  "packageManager": "bun@1.1.42",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx tsc && bunx vite build",
    "preview": "bunx vite preview",
    "tauri": "bunx tauri",
    "tauri:dev": "bunx tauri dev",
    "tauri:build": "bunx tauri build",
    "install:tauri": "bun install && cd src-tauri && cargo build",
    "clean": "rm -rf dist node_modules src-tauri/target bun.lockb bun.lock",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint . --ext .ts,.tsx",
    "update": "bun update",
    "test": "bun test",
    "ci": "bun install --frozen-lockfile && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
