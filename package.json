{
  "name": "macro",
  "version": "0.1.0",
  "description": "Local-first desktop environment for agentic software work.",
  "author": "Andrologic",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrologic/Macro.git"
  },
  "bugs": {
    "url": "https://github.com/Andrologic/Macro/issues"
  },
  "homepage": "https://github.com/Andrologic/Macro#readme",
  "keywords": [
    "agentic-development",
    "ai",
    "desktop",
    "git",
    "local-first",
    "react",
    "tauri",
    "typescript"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun ./dev/prepare-vite-dev.mjs && NODE_ENV=development bun node_modules/vite/bin/vite.js --host",
    "build:ai-runtime": "bun ./dev/build-ai-runtime.mjs",
    "build": "NODE_ENV=production bun node_modules/typescript/bin/tsc && NODE_ENV=production bun node_modules/vite/bin/vite.js build",
    "build:analyze": "NODE_ENV=production bun node_modules/vite/bin/vite.js build --mode analyze",
    "bundle:check": "bun ./dev/check-bundle-size.mjs",
    "repo:check-binaries": "bun ./dev/check-git-binaries.mjs",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "tauri": "bun dev/tauri-cli.mjs",
    "tauri:dev": "bun dev/tauri-cli.mjs dev",
    "tauri:build": "bun dev/tauri-cli.mjs build",
    "tauri:build:nsis": "bun dev/tauri-cli.mjs build --bundles nsis",
    "tauri:build:dmg": "bun dev/tauri-cli.mjs build --bundles dmg",
    "tauri:build:dmg:mac-arm64:test": "APPLE_SIGNING_IDENTITY=\"-\" NODE_ENV=production bun dev/tauri-cli.mjs build --target aarch64-apple-darwin --bundles app,dmg",
    "tauri:build:dmg:mac-universal:test": "APPLE_SIGNING_IDENTITY=\"-\" NODE_ENV=production bun dev/tauri-cli.mjs build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:debug": "bun dev/tauri-cli.mjs build --debug",
    "tauri:headless": "cargo run --manifest-path src-tauri/Cargo.toml --example macro-headless",
    "mac:verify-bundle": "bun ./dev/verify-macos-bundle.mjs",
    "install:tauri": "bun install && cd src-tauri && cargo build --release",
    "clean": "rm -rf dist node_modules src-tauri/target src-tauri/binaries bun.lockb .vite",
    "clean:cache": "rm -rf node_modules/.vite ~/.bun/install/cache",
    "i18n:audit": "bun dev/i18n/audit.mjs",
    "i18n:generate": "python dev/i18n/generate_locales.py",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun node_modules/eslint/bin/eslint.js . --ext .ts,.tsx",
    "update": "bun update",
    "test": "bun dev/run-tests.mjs",
    "version:sync": "bun dev/version/sync.mjs",
    "version:check": "bun dev/version/check.mjs",
    "version:bump": "bun dev/version/bump.mjs",
    "ci": "bun install --frozen-lockfile && bun run version:check && bun run repo:check-binaries && bun run typecheck && bun run lint && bun run i18n:audit && bun run test && bun run build:ai-runtime && cargo test --manifest-path src-tauri/Cargo.toml --locked -- --test-threads=1 && cargo check --manifest-path src-tauri/Cargo.toml --example macro-headless --locked && bun run build && bun run bundle:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lint": "6.9.6",
    "@codemirror/merge": "6.12.1",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@github/copilot-sdk": "0.2.2",
    "@lexical/clipboard": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@lexical/utils": "0.48.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@tanstack/react-virtual": "3.13.25",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-http": "2.5.7",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-store": "2.4.2",
    "@types/highlight.js": "10.1.0",
    "@xyflow/react": "12.10.2",
    "chevrotain": "11.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "highlight.js": "11.11.1",
    "i18next": "25.10.10",
    "i18next-browser-languagedetector": "8.2.1",
    "jotai": "2.20.0",
    "katex": "0.16.28",
    "langium": "4.2.0",
    "lexical": "0.48.0",
    "lucide-react": "0.563.0",
    "mermaid": "11.16.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "16.6.6",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-react": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tauri-apps/cli": "2.10.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.0",
    "bun-types": "1.3.13",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "happy-dom": "20.9.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.0",
    "terser": "5.49.0",
    "typescript-eslint": "8.59.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/language": "6.12.1",
    "@codemirror/lint": "6.9.6",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "brace-expansion": "1.1.18",
    "@babel/core": "7.29.7",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "js-yaml": "4.3.1",
    "lodash-es": "4.18.1",
    "picomatch": "4.0.4",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "rollup": "4.60.3",
    "uuid": "14.0.0",
    "ws": "8.21.0",
    "yaml": "2.8.4"
  },
  "trustedDependencies": [
    "@tauri-apps/cli",
    "esbuild"
  ]
}
