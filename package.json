{
  "name": "macro",
  "private": true,
  "version": "0.1.0-rc.3",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.1.42",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bunx vite --host",
    "build:ai-runtime": "bun ./dev/build-ai-runtime.mjs",
    "build": "NODE_ENV=production bunx tsc && NODE_ENV=production bunx vite build",
    "build:analyze": "NODE_ENV=production bunx vite build --mode analyze",
    "bundle:check": "bun ./dev/check-bundle-size.mjs",
    "repo:check-binaries": "bun ./dev/check-git-binaries.mjs",
    "preview": "bunx vite preview",
    "tauri": "bunx tauri",
    "tauri:dev": "bunx tauri dev",
    "tauri:build": "NODE_ENV=production bunx tauri build",
    "tauri:build:dmg": "NODE_ENV=production bunx tauri build --bundles dmg",
    "tauri:build:dmg:mac-arm64:test": "APPLE_SIGNING_IDENTITY=\"-\" NODE_ENV=production bunx tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "tauri:build:debug": "bunx tauri build --debug",
    "mac:verify-bundle": "bun ./dev/verify-macos-bundle.mjs",
    "icons:apple": "bash ./dev/generate-apple-icons.sh",
    "install:tauri": "bun install && cd src-tauri && cargo build --release",
    "clean": "rm -rf dist node_modules src-tauri/target src-tauri/binaries bun.lockb .vite",
    "clean:cache": "rm -rf node_modules/.vite ~/.bun/install/cache",
    "i18n:audit": "bun dev/i18n/audit.mjs",
    "i18n:generate": "python dev/i18n/generate_locales.py",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint . --ext .ts,.tsx",
    "update": "bun update",
    "test": "bun dev/run-tests.mjs",
    "version:sync": "bun dev/version/sync.mjs",
    "version:check": "bun dev/version/check.mjs",
    "version:bump": "bun dev/version/bump.mjs",
    "ci": "bun install --frozen-lockfile && bun run version:check && bun run repo:check-binaries && bun run typecheck && bun run lint && bun run i18n:audit && bun run test && cargo test --manifest-path src-tauri/Cargo.toml && bun run build && bun run bundle:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/merge": "6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@github/copilot-sdk": "^0.2.0",
    "@lexical/clipboard": "0.40.0",
    "@lexical/react": "0.40.0",
    "@lexical/selection": "0.40.0",
    "@lexical/utils": "0.40.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-http": "2.5.7",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-store": "2.4.2",
    "@types/highlight.js": "10.1.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "highlight.js": "11.11.1",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jotai": "^2.16.2",
    "katex": "0.16.28",
    "lexical": "0.40.0",
    "lucide-react": "^0.563.0",
    "mermaid": "11.12.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-react": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "unified": "11.0.5",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tauri-apps/cli": "2.10.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "bun-types": "latest",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.0",
    "typescript-eslint": "^8.46.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "trustedDependencies": [
    "@tauri-apps/cli",
    "esbuild"
  ]
}
