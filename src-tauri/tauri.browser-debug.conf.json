{
  "build": {
    "beforeDevCommand": "bun run build:ai-runtime && bun run dev:browser-runtime"
  },
  "app": {
    "windows": [
      {
        "title": "Macro — hôte du runtime navigateur",
        "width": 640,
        "height": 420,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "url": "browser-runtime-host.html",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "browser-runtime-debug",
          "description": "Autorise le pont du navigateur à renvoyer les réponses IPC en mode debug.",
          "windows": ["main"],
          "permissions": ["core:event:allow-emit"]
        }
      ]
    }
  }
}
