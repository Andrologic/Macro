{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macro",
  "version": "../package.json",
  "identifier": "com.macro.desktop",
  "build": {
    "beforeDevCommand": "bun run build:ai-runtime && bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build:ai-runtime && bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/macro-ai-runtime"
    ],
    "resources": {
      "resources/copilot-runtime-manifest.json": "copilot-runtime-manifest.json",
      "resources/licenses/github-copilot-cli-LICENSE.md": "licenses/github-copilot-cli-LICENSE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French",
          "Spanish",
          "German",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Macro",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost https: blob: data:; media-src 'self' asset: http://asset.localhost https: blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMjc5N0MzNzMzNzEyNkEKUldScUVqZHp3NWNuc2Q3WExsZHlvZDV2bVlCZEVIMkJrZVRpaTh6VjN2VHkyNGtoNnNFaE9oYkEK",
      "endpoints": [
        "https://github.com/Andrologic/Macro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
