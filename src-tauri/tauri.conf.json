{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macro",
  "version": "../package.json",
  "identifier": "com.macro.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/macro-copilot-bridge*",
      "resources/copilot-runtime-manifest.json",
      "resources/licenses/github-copilot-cli-LICENSE.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "macro",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
