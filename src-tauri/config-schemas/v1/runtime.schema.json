{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeDocument",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowedRoots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "defaultWorkspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "headless": {
      "anyOf": [
        {
          "$ref": "#/definitions/HeadlessSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "HeadlessSettings": {
      "type": "object",
      "properties": {
        "autoStart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "bindAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
