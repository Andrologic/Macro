{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsDocument",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "appearance": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppearanceSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "applications": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApplicationSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/definitions/CodeDisplaySettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectTransferResources": {
      "anyOf": [
        {
          "$ref": "#/definitions/ConnectTransferResources"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "notifications": {
      "anyOf": [
        {
          "$ref": "#/definitions/NotificationSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "promptHistoryNavigationMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "shortcuts": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AppearanceSettings": {
      "type": "object",
      "properties": {
        "nativeMacosTitlebarBackground": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeMacosTitlebarTheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "type": [
            "string",
            "null"
          ]
        },
        "zoomLevel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "zoomMode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ApplicationSettings": {
      "type": "object",
      "properties": {
        "editorApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "editorCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "filesApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "filesCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminalApp": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminalCommand": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "CodeDisplaySettings": {
      "type": "object",
      "properties": {
        "overflowMode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ConnectTransferResources": {
      "description": "Native transfer budgets. This is an allocation policy, not a transcript limit.",
      "type": "object",
      "properties": {
        "diskFloorMiB": {
          "default": 2048,
          "type": "integer",
          "format": "uint32",
          "maximum": 65536.0,
          "minimum": 512.0
        },
        "retainedCeilingMiB": {
          "default": 8192,
          "type": "integer",
          "format": "uint32",
          "maximum": 65536.0,
          "minimum": 256.0
        },
        "version": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "maximum": 1.0,
          "minimum": 1.0
        },
        "workingCeilingMiB": {
          "default": 512,
          "type": "integer",
          "format": "uint32",
          "maximum": 4096.0,
          "minimum": 64.0
        }
      },
      "additionalProperties": false
    },
    "NotificationSettings": {
      "type": "object",
      "properties": {
        "channelModes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "inAppEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
