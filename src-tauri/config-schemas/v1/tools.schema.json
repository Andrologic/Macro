{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolsDocument",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "builtIn": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "mcpServers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/McpServerDefinition"
      }
    },
    "modes": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "projectCommands": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/ExternalCommandDefinition"
      }
    },
    "projectMcpApprovals": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/ContentApproval"
      }
    },
    "projectSwitchPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "riskLevel": {
      "anyOf": [
        {
          "$ref": "#/definitions/ToolRiskLevel"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "webSearch": {
      "anyOf": [
        {
          "$ref": "#/definitions/WebSearchSettings"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ContentApproval": {
      "type": "object",
      "required": [
        "contentHash",
        "grantedAt",
        "grantedBy"
      ],
      "properties": {
        "contentHash": {
          "type": "string"
        },
        "grantedAt": {
          "type": "string"
        },
        "grantedBy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExternalCommandDefinition": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "openTerminalOnRun": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectName": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktreeSetupCommand": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "McpProtocolMode": {
      "type": "string",
      "enum": [
        "auto",
        "legacy",
        "modern"
      ]
    },
    "McpProtocolSettings": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/McpProtocolMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "probeTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 15000.0,
          "minimum": 500.0
        }
      },
      "additionalProperties": false
    },
    "McpServerDefinition": {
      "type": "object",
      "required": [
        "transport"
      ],
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabledTools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxConcurrentOperations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 16.0,
          "minimum": 1.0
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 600000.0,
          "minimum": 1000.0
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/definitions/McpProtocolSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "startupTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 300000.0,
          "minimum": 1000.0
        },
        "transport": {
          "$ref": "#/definitions/McpTransport"
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "McpTransport": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "command",
            "type"
          ],
          "properties": {
            "args": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "command": {
              "type": "string"
            },
            "env": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "stdio"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "headers": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "sse"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "headers": {
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "streamable_http"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ToolRiskLevel": {
      "type": "string",
      "enum": [
        "strict",
        "balanced",
        "yolo"
      ]
    },
    "WebSearchSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fetchEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maxResults": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "secretRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
