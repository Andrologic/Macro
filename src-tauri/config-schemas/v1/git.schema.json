{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitDocument",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "branchTemplates": {
      "anyOf": [
        {
          "$ref": "#/definitions/BranchTemplateSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "completionMergePolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "configurationState": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "mainBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadataAutoPush": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "metadataMissingUpstreamPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "syncTargetBeforeFinish": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BranchTemplateSettings": {
      "type": "object",
      "properties": {
        "bugfix": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature": {
          "type": [
            "string",
            "null"
          ]
        },
        "hotfix": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "standaloneFeature": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
